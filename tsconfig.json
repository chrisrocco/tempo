{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "jasmine"]
  },
  "include": ["src/**/*.ts", "spec/**/*.ts", "examples/**/*.ts", "bin/**/*.ts"]
}
