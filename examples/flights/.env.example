# Copy to .env and fill in. .env is gitignored; this file is not.

# Flight search. Use a TEST token — we only ever search, never book.
DUFFEL_ACCESS_TOKEN=duffel_test_...

# Or, for live Google Flights results via SerpApi (free tier: 250/month).
SERPAPI_API_KEY=

# Google OAuth, for calendar + drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
