{
  // The dashboard is checked separately from the engine because the two run in
  // different places: browser code needs the DOM lib and must NOT see Node's
  // globals, and the engine is the reverse. One config covering both would have
  // to union the two environments, which is how `document` becomes available in
  // a workflow and `process` in a custom element.
  //
  // This is also what makes the sprint's central claim true rather than
  // aspirational: the dashboard imports `ExecutionDetail` and `isStuck` from
  // `protocol/` rather than restating them, so a field added to a projection is
  // a compile error here. Nothing checked `ui/` before this file existed, so
  // that error had nowhere to appear. `npm run typecheck` runs both configs.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["**/*.ts"]
}
